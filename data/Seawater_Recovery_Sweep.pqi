TITLE Real Seawater - Recovery Sweep

SELECTED_OUTPUT 1
    -file Recovery_Sweep_Selected.txt
    -reset false
    -solution true
    -user_punch true
    -high_precision true

USER_PUNCH 1
    -headings Water_Activity Osmotic_Coefficient Ionic_Strength Charge_Error
    -start
    10 PUNCH ACT("H2O"), OSMOTIC, MU, PERCENT_ERROR
    -end

